+.frame::before,.frame::after{content:"";position:absolute;width:22px;height:22px;border:2px solid var(--amber)}
+.frame::before{top:-2px;left:-2px;border-right:0;border-bottom:0}
+.frame::after{bottom:-2px;right:-2px;border-left:0;border-top:0}
+.frame figcaption{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 2px 0;font-family:var(--f-mono);font-size:.76rem;letter-spacing:.1em;color:var(--ice-dim);text-transform:uppercase}
+.frame figcaption .rec::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--signal);margin-right:8px;vertical-align:0;animation:blink 1.2s steps(2,start) infinite}
+figure{margin:0}
+.sortie{list-style:none;margin:0;padding:0;display:grid;gap:0;counter-reset:s}
+.sortie li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:4px 14px;padding-block:18px;border-top:1px solid var(--line)}
+.sortie li:last-child{border-bottom:1px solid var(--line)}
+.sortie li::before{counter-increment:s;content:"0" counter(s);font-family:var(--f-mono);color:var(--amber);font-size:.95rem;padding-top:4px;grid-row:span 2}
+.sortie h3{font-size:var(--step-1);letter-spacing:.03em}
+.sortie p{color:var(--ice-dim);font-size:.98rem}
+
+/* missions */
+.ops{display:grid;border-top:1px solid var(--line)}
+.op{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.9fr) 210px;gap:10px 28px;align-items:baseline;padding-block:22px;border-bottom:1px solid var(--line);transition:background .2s ease}
+.op:hover{background:linear-gradient(90deg,var(--hull) 0%,transparent 80%)}
