+.bar{display:flex;align-items:center;gap:10px;min-width:180px}
+.bar .track{flex:1;height:8px;background:var(--hull-2);position:relative;overflow:hidden}
+.bar .fill{position:absolute;inset:0 auto 0 0;background:linear-gradient(90deg,var(--amber),var(--signal))}
+.bar .val{font-family:var(--f-mono);font-size:.82rem;color:var(--ice);min-width:68px;text-align:right}
+.callouts{display:grid;gap:16px}
