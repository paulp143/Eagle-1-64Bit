+.op p{color:var(--ice-dim);max-width:58ch}
+.op .meta{font-family:var(--f-mono);font-size:.78rem;letter-spacing:.1em;color:var(--blip);text-align:right;white-space:nowrap}
+.op.boss .meta{color:var(--signal)}
+@media (max-width:820px){.op{grid-template-columns:1fr}.op .meta{text-align:left;white-space:normal}}
+
+/* arsenal */
+.arsenal{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:clamp(24px,4vw,56px);align-items:start}
