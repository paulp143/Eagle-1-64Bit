+.strikes th{font-family:var(--f-mono);font-weight:400;font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ice-dim);text-align:left;padding:0 10px 10px 0;border-bottom:1px solid var(--line)}
+.strikes td{padding:12px 10px 12px 0;border-bottom:1px solid var(--line);vertical-align:middle}
