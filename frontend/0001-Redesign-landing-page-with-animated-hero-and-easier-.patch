diff --git a/frontend/index.html b/frontend/index.html
index fa1dd00..716c645 100644
--- a/frontend/index.html
+++ b/frontend/index.html
@@ -1,142 +1,675 @@
-<!DOCTYPE html>
+<!doctype html>
 <html lang="en">
 <head>
-  <meta charset="UTF-8">
-  <meta name="viewport" content="width=device-width, initial-scale=1.0">
-  <meta name="description" content="Super Earth Needs You! Pilot Eagle-1 in 64-bit close air support combat against the Automaton threat. Download free for Windows.">
-  <meta name="theme-color" content="#ffcc00">
-
-  <title>EAGLE-1: 64-BIT // ENLIST FOR SUPER EARTH</title>
-  <link rel="stylesheet" href="./style.css">
-  <link rel="icon" type="image/png" href="./assets/eagle1-ship.png">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<meta name="theme-color" content="#070b14">
+<link rel="icon" type="image/png" href="./assets/eagle1-ship.png">
+<meta property="og:title" content="Eagle-1 64Bit">
+<meta property="og:description" content="Free fan-made air-combat game in the Helldivers universe. Fly close air support for your squad.">
+<meta property="og:image" content="./assets/gameplay.webp">
+<title>Eagle-1 64Bit</title>
+<meta name="description" content="Eagle-1 64Bit: a free fan-made air-combat game in the Helldivers universe. Fly close air support for your squad. Download for Windows.">
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Stencil+One&family=Barlow+Semi+Condensed:wght@400;500;600;700&family=Share+Tech+Mono&display=swap">
+<style>
+body{margin:0}
+/* Layout: full-bleed flight-deck hero with a live sortie, then a left-aligned briefing column of HUD-framed panels. One committed dark world. */
+:root{
+  --void:#070b14;      /* deep orbit */
+  --hull:#0f1828;      /* panel plating */
+  --hull-2:#152238;
+  --line:#25344d;
+  --ice:#cfe0ec;       /* frozen battlefield */
+  --ice-dim:#8ea3b8;
+  --amber:#f5b51c;     /* call to action, ordnance */
+  --amber-ink:#1a1204;
+  --signal:#e2432f;    /* hostiles, Eagle-1 trim */
+  --blip:#5fd6e9;      /* friendly squad, HUD */
+  --f-display:"Saira Stencil One","Impact","Arial Narrow Bold",sans-serif;
+  --f-body:"Barlow Semi Condensed","Arial Narrow","Helvetica Neue",Arial,sans-serif;
+  --f-mono:"Share Tech Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
+  --step--1:clamp(.82rem,.78rem + .2vw,.9rem);
+  --step-0:clamp(1rem,.96rem + .25vw,1.12rem);
+  --step-1:clamp(1.2rem,1.1rem + .5vw,1.45rem);
+  --step-2:clamp(1.6rem,1.3rem + 1.4vw,2.4rem);
+  --step-3:clamp(2.2rem,1.6rem + 3vw,3.8rem);
+  --step-4:clamp(3.6rem,2rem + 8vw,8.5rem);
+  color-scheme:dark;
+}
+*{box-sizing:border-box}
+html{scroll-behavior:smooth;background:var(--void)}
+@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
+body{background:var(--void);color:var(--ice);font-family:var(--f-body);font-size:var(--step-0);line-height:1.55;-webkit-font-smoothing:antialiased}
+a{color:inherit}
+img{max-width:100%;display:block}
+h1,h2,h3{font-family:var(--f-display);font-weight:400;line-height:.95;letter-spacing:.01em;text-wrap:balance;margin:0}
+p{margin:0}
+:focus-visible{outline:2px solid var(--amber);outline-offset:3px}
+.wrap{max-width:1160px;margin-inline:auto;padding-inline:20px}
+.mono{font-family:var(--f-mono);letter-spacing:.04em}
+.label{font-family:var(--f-mono);font-size:var(--step--1);letter-spacing:.14em;text-transform:uppercase;color:var(--ice-dim)}
+
+/* ---------- nav ---------- */
+.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--void) 82%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
+.nav .wrap{display:flex;align-items:center;gap:24px;min-height:60px}
+.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--f-display);font-size:1.35rem;letter-spacing:.04em}
+.brand img{width:22px;image-rendering:pixelated}
+.brand small{font-family:var(--f-mono);font-size:.72rem;color:var(--ice-dim);letter-spacing:.12em}
+.nav-links{display:flex;gap:22px;margin-left:auto}
+.nav-links a{text-decoration:none;font-weight:600;font-size:.95rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ice-dim)}
+.nav-links a:hover{color:var(--ice)}
+.nav .btn-sm{margin-left:0}
+@media (max-width:720px){.nav-links{display:none}.nav .btn-sm{margin-left:auto}}
+
+/* ---------- buttons ---------- */
+.btn{display:inline-flex;align-items:center;gap:14px;text-decoration:none;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:0;cursor:pointer;font-family:var(--f-body)}
+.btn-primary{background:var(--amber);color:var(--amber-ink);padding:14px 22px 14px 18px;font-size:1.08rem;clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));transition:transform .15s ease,filter .15s ease}
+.btn-primary:hover{filter:brightness(1.08);transform:translateY(-1px)}
+.btn-primary svg{flex:none}
+.btn-primary .meta{display:block;font-family:var(--f-mono);font-weight:400;font-size:.74rem;letter-spacing:.08em;opacity:.78;text-transform:none}
+.btn-primary .stack{display:flex;flex-direction:column;line-height:1.15}
+.btn-ghost{color:var(--ice);padding:14px 18px;border:1px solid var(--line);background:color-mix(in srgb,var(--hull) 70%,transparent);font-size:.98rem}
+.btn-ghost:hover{border-color:var(--ice-dim)}
+.btn-sm{background:var(--amber);color:var(--amber-ink);padding:9px 14px;font-size:.85rem;clip-path:polygon(0 0,calc(100% - 9px) 0,100% 9px,100% 100%,9px 100%,0 calc(100% - 9px))}
+
+/* ---------- hero ---------- */
+.hero{position:relative;height:clamp(600px,88vh,860px);overflow:hidden;isolation:isolate;border-bottom:1px solid var(--line)}
+.hero canvas{position:absolute;inset:0;width:100%;height:100%;z-index:-2;display:block;background:#0c1422}
+.hero::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
+  background:linear-gradient(90deg,rgba(7,11,20,.92) 0%,rgba(7,11,20,.7) 34%,rgba(7,11,20,0) 62%),linear-gradient(0deg,rgba(7,11,20,.95) 0%,rgba(7,11,20,0) 30%)}
+@media (max-width:760px){.hero{height:auto}.hero-inner{padding-top:300px}.hero::after{background:linear-gradient(0deg,rgba(7,11,20,.97) 0%,rgba(7,11,20,.9) 56%,rgba(7,11,20,.15) 72%,rgba(7,11,20,0) 100%)}.hud .obj .pre{display:none}}
+.hero-inner{position:relative;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding-block:48px 56px;gap:18px}
+.hero-inner > *{max-width:560px}
+.eyebrow{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}
+.eyebrow .tag{font-family:var(--f-mono);font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;padding:4px 8px;border:1px solid var(--line);background:rgba(7,11,20,.6);color:var(--ice-dim)}
+.eyebrow .tag.live{color:var(--blip);border-color:color-mix(in srgb,var(--blip) 45%,transparent)}
+.eyebrow .tag.live::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--blip);margin-right:8px;vertical-align:1px;animation:blink 1.4s steps(2,start) infinite}
+@keyframes blink{50%{opacity:.15}}
+.hero h1{font-size:var(--step-4);color:var(--ice);text-shadow:0 2px 0 rgba(0,0,0,.4)}
+.hero h1 span{color:var(--amber)}
+.hero .tagline{font-family:var(--f-display);font-size:var(--step-2);color:var(--ice);line-height:1}
+.hero .lede{color:var(--ice);opacity:.88;max-width:52ch}
+.cta-row{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:6px}
+.hero .fine{font-family:var(--f-mono);font-size:.78rem;letter-spacing:.06em;color:var(--ice-dim)}
+
+.hud{position:absolute;inset:18px;pointer-events:none;z-index:1;font-family:var(--f-mono);font-size:.74rem;letter-spacing:.12em;color:var(--blip)}
+.hud .corner{position:absolute;width:26px;height:26px;border-color:color-mix(in srgb,var(--blip) 60%,transparent);border-style:solid;border-width:0}
+.hud .tl{top:0;left:0;border-top-width:1.5px;border-left-width:1.5px}
+.hud .tr{top:0;right:0;border-top-width:1.5px;border-right-width:1.5px}
+.hud .bl{bottom:0;left:0;border-bottom-width:1.5px;border-left-width:1.5px}
+.hud .br{bottom:0;right:0;border-bottom-width:1.5px;border-right-width:1.5px}
+.hud .readout{position:absolute;top:10px;right:38px;text-align:right;display:grid;gap:4px;text-shadow:0 1px 2px rgba(0,0,0,.8)}
+.hud .readout b{color:var(--ice);font-weight:400}
+.hud .obj{position:absolute;top:10px;left:38px;color:var(--amber);text-shadow:0 1px 2px rgba(0,0,0,.8)}
+@media (max-width:760px){.hud .readout{display:none}}
+.strike-flash{position:absolute;left:50%;top:22%;transform:translate(-50%,-50%) scale(.96);font-family:var(--f-mono);font-size:.82rem;letter-spacing:.18em;color:var(--amber-ink);background:var(--amber);padding:6px 12px;opacity:0;transition:opacity .25s ease,transform .25s ease;pointer-events:none;z-index:1;white-space:nowrap}
+.strike-flash.on{opacity:1;transform:translate(-50%,-50%) scale(1)}
+@media (min-width:761px){.strike-flash{left:68%}}
+
+/* ---------- spec strip ---------- */
+.specs{border-bottom:1px solid var(--line);background:var(--hull)}
+.specs ul{list-style:none;margin:0;padding-block:18px;display:flex;flex-wrap:wrap;gap:10px 0}
+.specs li{flex:1 1 180px;display:flex;align-items:baseline;gap:10px;padding-right:18px}
+.specs b{font-family:var(--f-display);font-weight:400;font-size:var(--step-2);color:var(--amber);line-height:1;font-variant-numeric:tabular-nums}
+.specs span{font-family:var(--f-mono);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ice-dim)}
+
+/* ---------- sections ---------- */
+section.block{padding-block:clamp(64px,9vw,120px)}
+.section-head{display:grid;gap:14px;margin-bottom:clamp(28px,4vw,48px);max-width:720px}
+.section-head h2{font-size:var(--step-3)}
+.section-head p{color:var(--ice-dim);max-width:60ch}
+
+/* gun camera */
